#include <iostream>
#include <vector>
#include <queue>
#include <string>
using namespace std;

class SmartCity {
    int n;
    vector<string> name;
    vector<vector<int> > roads;

public:
    SmartCity(int size) {
        n = size;
        name.resize(n);
        roads.resize(n);
    }

    void inputJunctions() {
        cout << "\nEnter junction names:\n";

        for (int i = 0; i < n; i++) {
            cout << "Junction " << i << ": ";
            cin >> name[i];
        }
    }

    void addRoad(int u, int v) {
        roads[u].push_back(v);
        roads[v].push_back(u);
    }

    void displayRoads() {
        cout << "\n--- SMART CITY ROAD NETWORK ---\n";

        for (int i = 0; i < n; i++) {
            cout << name[i] << " -> ";

            for (int j = 0; j < roads[i].size(); j++) {
                int v = roads[i][j];
                cout << name[v] << " ";
            }

            cout << endl;
        }
    }

    void BFS(int start) {
        vector<bool> visited(n, false);
        queue<int> q;

        visited[start] = true;
        q.push(start);

        cout << "\nBFS Visiting Order: ";

        while (!q.empty()) {
            int u = q.front();
            q.pop();

            cout << name[u] << " ";

            for (int j = 0; j < roads[u].size(); j++) {
                int v = roads[u][j];

                if (!visited[v]) {
                    visited[v] = true;
                    q.push(v);
                }
            }
        }

        cout << endl;
    }
};

int main() {
    int n, e, u, v, start;

    cout << "SMART CITY ROAD NETWORK USING BFS\n";

    cout << "Enter number of junctions: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of junctions!";
        return 0;
    }

    SmartCity city(n);

    city.inputJunctions();

    cout << "\nEnter number of roads: ";
    cin >> e;

    cout << "\nEnter road connections using junction numbers:\n";

    for (int i = 0; i < e; i++) {
        cout << "Road " << i + 1 << " (u v): ";
        cin >> u >> v;

        if (u >= 0 && u < n && v >= 0 && v < n) {
            city.addRoad(u, v);
        } else {
            cout << "Invalid junction numbers! Try again.\n";
            i--;
        }
    }

    city.displayRoads();

    cout << "\nEnter starting junction number (0 to "
         << n - 1 << "): ";
    cin >> start;

    if (start >= 0 && start < n) {
        city.BFS(start);
    } else {
        cout << "Invalid starting junction!";
    }

    return 0;
}
 